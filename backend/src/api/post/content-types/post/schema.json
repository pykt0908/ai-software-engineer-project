{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post",
    "description": "User posts"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "caption": {
      "type": "text",
      "maxLength": 2200
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "moderationStatus": {
      "type": "enumeration",
      "enum": [
        "visible",
        "hidden"
      ],
      "default": "visible"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "posts"
    },
    "likes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post-like.post-like",
      "mappedBy": "post"
    }
  }
}
